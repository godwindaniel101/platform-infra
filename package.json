{
  "name": "platform-infra",
  "version": "1.0.0",
  "private": true,
  "description": "Shared infrastructure and end-to-end scenarios. Not a service.",
  "type": "module",
  "scripts": {
    "up": "docker compose up -d",
    "down": "docker compose down",
    "reset": "docker compose down -v && docker compose up -d",
    "logs": "docker compose logs -f",
    "wait-for-infra": "node scripts/wait-for-infra.mjs",
    "webhooks": "node scripts/create-webhooks.mjs",
    "e2e": "vitest run --config vitest.config.ts",
    "e2e:watch": "vitest --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "ioredis": "^5.4.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
